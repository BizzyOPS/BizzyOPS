# BizzyOPS .htaccess Configuration
# Enhanced URL rewriting, security, and performance optimizations

# ========================================
# REWRITE ENGINE
# ========================================
RewriteEngine On

# ========================================
# SECURITY HEADERS
# ========================================
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options nosniff
    
    # Enable XSS Protection
    Header always set X-XSS-Protection "1; mode=block"
    
    # Prevent clickjacking (Updated for Tawk.to compatibility)
    Header always set X-Frame-Options "SAMEORIGIN"
    # Allow Tawk.to frames
    <LocationMatch "tawk">
        Header unset X-Frame-Options
    </LocationMatch>
    
    # Strict Transport Security (HTTPS only - uncomment when SSL is active)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    
    # Content Security Policy (Updated for Tawk.to compatibility)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://embed.tawk.to https://va.tawk.to https://*.tawk.to https://fonts.googleapis.com https://api.web3forms.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.tawk.to; font-src 'self' https://fonts.gstatic.com https://*.tawk.to; img-src 'self' data: https: https://*.tawk.to; connect-src 'self' wss://*.tawk.to https://embed.tawk.to https://va.tawk.to https://*.tawk.to https://api.web3forms.com; frame-src 'self' https://embed.tawk.to https://*.tawk.to; child-src 'self' https://embed.tawk.to https://*.tawk.to;"
    
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ========================================
# URL SANITIZATION & CLEAN URLS
# ========================================

# Remove .html extension from URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# Redirect .html extension to clean URLs
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1? [NC,L,R=301]

# Remove trailing slash from non-directory URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} /(.+)/$
RewriteRule ^ /%1 [R=301,L]

# Add trailing slash to directories
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^ %{REQUEST_URI}/ [R=301,L]

# ========================================
# CANONICAL URL ENFORCEMENT
# ========================================

# Force www (uncomment if you want to force www)
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Force non-www (uncomment if you want to force non-www)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Force HTTPS (uncomment when SSL certificate is installed)
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ========================================
# FRIENDLY URL REDIRECTS
# ========================================

# Redirect old URLs to new clean URLs
RedirectMatch 301 ^/index\.html$ /
RedirectMatch 301 ^/home\.html$ /
RedirectMatch 301 ^/contact\.html$ /contact
RedirectMatch 301 ^/about\.html$ /about
RedirectMatch 301 ^/services\.html$ /services
RedirectMatch 301 ^/blog\.html$ /blog
RedirectMatch 301 ^/knowledge\.html$ /knowledge

# Service page redirects
RedirectMatch 301 ^/services/managed-it-support\.html$ /services/managed-it-support
RedirectMatch 301 ^/services/help-desk-support\.html$ /services/help-desk-support
RedirectMatch 301 ^/services/hardware-server-support\.html$ /services/hardware-server-support
RedirectMatch 301 ^/services/cybersecurity-assessment\.html$ /services/cybersecurity-assessment

# Blog post redirects
RedirectMatch 301 ^/blog/(.+)\.html$ /blog/$1

# Knowledge base redirects
RedirectMatch 301 ^/knowledge/(.+)\.html$ /knowledge/$1

# Legal pages redirects
RedirectMatch 301 ^/privacy-policy\.html$ /privacy-policy
RedirectMatch 301 ^/terms-of-service\.html$ /terms-of-service
RedirectMatch 301 ^/cookies-policy\.html$ /cookies-policy

# ========================================
# ERROR PAGE HANDLING
# ========================================
ErrorDocument 404 /404.html
ErrorDocument 403 /403.html
ErrorDocument 500 /500.html

# ========================================
# PERFORMANCE OPTIMIZATION
# ========================================

# Enable GZIP compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS and JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    
    # HTML
    ExpiresByType text/html "access plus 1 day"
    
    # Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    
    # Manifest and other files
    ExpiresByType application/manifest+json "access plus 1 week"
    ExpiresByType text/xml "access plus 1 week"
    ExpiresByType application/xml "access plus 1 week"
</IfModule>

# ========================================
# SECURITY ENHANCEMENTS
# ========================================

# Block access to sensitive files
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|inc|bak|backup|swp|tmp)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block access to version control directories
RedirectMatch 404 /\.git
RedirectMatch 404 /\.svn

# Prevent access to WordPress and other CMS files (if applicable)
<FilesMatch "(wp-config\.php|readme\.html|license\.txt)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block suspicious request methods
<Limit GET POST HEAD>
    Order Allow,Deny
    Allow from all
</Limit>
<LimitExcept GET POST HEAD>
    Order Deny,Allow
    Deny from all
</LimitExcept>

# ========================================
# SEO ENHANCEMENTS
# ========================================

# Set default charset
AddDefaultCharset UTF-8

# Prevent duplicate content for index files
DirectoryIndex index.html index.php

# ========================================
# CUSTOM REDIRECTS FOR BIZZYOPS
# ========================================

# Emergency contact shortcuts
Redirect 301 /emergency /contact
Redirect 301 /sos /contact
Redirect 301 /help /contact
Redirect 301 /support /contact

# Service shortcuts
Redirect 301 /it-support /services/managed-it-support
Redirect 301 /managed-it /services/managed-it-support
Redirect 301 /helpdesk /services/help-desk-support
Redirect 301 /help-desk /services/help-desk-support
Redirect 301 /cybersecurity /services/cybersecurity-assessment
Redirect 301 /security /services/cybersecurity-assessment
Redirect 301 /server-support /services/hardware-server-support
Redirect 301 /hardware /services/hardware-server-support

# Knowledge base shortcuts
Redirect 301 /kb /knowledge
Redirect 301 /guides /knowledge
Redirect 301 /documentation /knowledge
Redirect 301 /docs /knowledge

# Blog shortcuts
Redirect 301 /news /blog
Redirect 301 /articles /blog
Redirect 301 /posts /blog

# Legal shortcuts
Redirect 301 /privacy /privacy-policy
Redirect 301 /terms /terms-of-service
Redirect 301 /cookies /cookies-policy
Redirect 301 /gdpr /privacy-policy

# ========================================
# ADDITIONAL OPTIMIZATIONS
# ========================================

# Remove Server Signature
ServerSignature Off

# Disable ETags
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

# Prevent hotlinking of images
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?bizzyops\. [NC]
RewriteCond %{REQUEST_URI} \.(jpg|jpeg|png|gif|svg|webp)$ [NC]
RewriteRule \.(jpg|jpeg|png|gif|svg|webp)$ - [F]

# Custom 404 handling for missing files
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|json|xml|txt)$ [NC]
RewriteRule . /404.html [L]